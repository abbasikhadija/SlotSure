{
  "name": "@slotsure/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:check": "node --env-file-if-exists=.env src/db/check.js",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed-consultant.js",
    "db:test:setup": "node --env-file-if-exists=.env src/db/setup-test.js",
    "test:db": "node --env-file-if-exists=.env src/db/test.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "luxon": "^3.7.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "pdfjs-dist": "^6.4.299"
  }
}
