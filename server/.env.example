PORT=3000
HOST=127.0.0.1
CONSULTANT_TIME_ZONE=Asia/Karachi
# Generate a random secret before starting the API (see README); no default secret.
SESSION_SECRET=CHANGE_ME
APP_ORIGIN=http://127.0.0.1:5173
# Set to 1 only behind exactly one trusted reverse proxy; default is 0.
TRUST_PROXY=0
# Optional local compiled-client preview; production always serves the build.
SERVE_CLIENT=0
# Replace with your own local credentials. Never expose this value to Vite.
DATABASE_URL=postgresql://slotsure:CHANGE_ME@127.0.0.1:5432/slotsure
# Separate real PostgreSQL integration database; never use the development database.
# TEST_DATABASE_URL=postgresql://slotsure:CHANGE_ME@127.0.0.1:5432/slotsure_test
# Controlled local consultant seed (encoded Argon2id hash, never plaintext):
# CONSULTANT_NAME=Demo Consultant
# CONSULTANT_EMAIL=consultant@example.test
# CONSULTANT_PASSWORD_HASH='REPLACE_WITH_ENCODED_ARGON2ID_HASH'
