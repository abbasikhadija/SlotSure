NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://slotsure.example.com
CONSULTANT_TIME_ZONE=Asia/Karachi
# Replace with independently generated random bytes; never use a shared demo secret.
SESSION_SECRET=CHANGE_ME
# Exactly one trusted TLS reverse proxy is the only public route to this listener.
TRUST_PROXY=1
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST:5432/REPLACE_DB_NAME
